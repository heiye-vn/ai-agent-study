{"type": "excalidraw", "version": 2, "source": "https://excalidraw.com", "elements": [{"id": "1", "type": "rectangle", "x": 50, "y": 50, "width": 400, "height": 70, "strokeColor": "#a5d8ff", "backgroundColor": "#ffffff", "fillStyle": "hachure", "fontSize": 20, "fontFamily": 5, "text": "DeepAgents Skills 工作流\n技能代理核心流程"}, {"id": "2", "type": "rectangle", "x": 100, "y": 150, "width": 150, "height": 50, "strokeColor": "#a5d8ff", "backgroundColor": "#ffffff", "fillStyle": "hachure", "fontSize": 16, "fontFamily": 5, "text": "① 用户 Prompt"}, {"id": "3", "type": "rectangle", "x": 100, "y": 250, "width": 150, "height": 50, "strokeColor": "#a5d8ff", "backgroundColor": "#ffffff", "fillStyle": "hachure", "fontSize": 16, "fontFamily": 5, "text": "② 创建 Agent\n(createAgent)"}, {"id": "4", "type": "rectangle", "x": 100, "y": 350, "width": 150, "height": 50, "strokeColor": "#a5d8ff", "backgroundColor": "#ffffff", "fillStyle": "hachure", "fontSize": 16, "fontFamily": 5, "text": "③ 创建技能中间件\n(createSkillsMiddleware)"}, {"id": "5", "type": "rectangle", "x": 100, "y": 450, "width": 150, "height": 50, "strokeColor": "#a5d8ff", "backgroundColor": "#ffffff", "fillStyle": "hachure", "fontSize": 16, "fontFamily": 5, "text": "④ 创建文件系统中间件\n(createFilesystemMiddleware)"}, {"id": "6", "type": "rectangle", "x": 100, "y": 550, "width": 150, "height": 50, "strokeColor": "#a5d8ff", "backgroundColor": "#ffffff", "fillStyle": "hachure", "fontSize": 16, "fontFamily": 5, "text": "⑤ 模型回复"}, {"id": "7", "type": "arrow", "x": 100, "y": 200, "width": 0, "height": 0, "points": [[50, 50], [100, 170]], "strokeColor": "#000000", "fontSize": 14, "fontFamily": 5, "text": "invoke"}, {"id": "8", "type": "arrow", "x": 100, "y": 300, "width": 0, "height": 0, "points": [[100, 200], [100, 270]], "strokeColor": "#000000", "fontSize": 14, "fontFamily": 5, "text": "wrapModelCall"}, {"id": "9", "type": "arrow", "x": 100, "y": 400, "width": 0, "height": 0, "points": [[100, 300], [100, 370]], "strokeColor": "#000000", "fontSize": 14, "fontFamily": 5, "text": "middlewareSetup"}, {"id": "10", "type": "arrow", "x": 100, "y": 500, "width": 0, "height": 0, "points": [[100, 400], [100, 470]], "strokeColor": "#000000", "fontSize": 14, "fontFamily": 5, "text": "filesystemIntegration"}, {"id": "11", "type": "arrow", "x": 100, "y": 600, "width": 0, "height": 0, "points": [[100, 500], [100, 570]], "strokeColor": "#000000", "fontSize": 14, "fontFamily": 5, "text": "responseGeneration"}, {"id": "12", "type": "text", "x": 350, "y": 200, "width": 400, "height": 50, "strokeColor": "#000000", "fontSize": 14, "fontFamily": 5, "text": "说明：用户输入触发整个流程"}, {"id": "13", "type": "text", "x": 350, "y": 300, "width": 400, "height": 50, "strokeColor": "#000000", "fontSize": 14, "fontFamily": 5, "text": "说明：初始化代理对象"}, {"id": "14", "type": "text", "x": 350, "y": 400, "width": 400, "height": 50, "strokeColor": "#000000", "fontSize": 14, "fontFamily": 5, "text": "说明：设置技能相关的中间件"}, {"id": "15", "type": "text", "x": 350, "y": 500, "width": 400, "height": 50, "strokeColor": "#000000", "fontSize": 14, "fontFamily": 5, "text": "说明：集成文件系统功能"}, {"id": "16", "type": "text", "x": 350, "y": 600, "width": 400, "height": 50, "strokeColor": "#000000", "fontSize": 14, "fontFamily": 5, "text": "说明：模型生成回复"}, {"id": "17", "type": "text", "x": 50, "y": 700, "width": 400, "height": 50, "strokeColor": "#000000", "fontSize": 14, "fontFamily": 5, "text": "图例：\n浅蓝色 (#a5d8ff) - 主要步骤\n白色背景 - 清晰显示文本\n黑色箭头 - 连接步骤\n如何运行 demo：\n1. 访问 https://excalidraw.com\n2. 点击 'Open' 或拖放文件\n3. 或使用 VS Code 插件打开"}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": 20}, "files": {}}